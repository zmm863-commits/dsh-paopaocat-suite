{
  "name": "dsh-paopaocat-welcome",
  "version": "0.1.0",
  "description": "泡泡猫新手引导中心 — 首次打开欢迎卡、功能导航、反馈入口。 / Paopaocat welcome center — first-run greeting, feature navigation, feedback.",
  "type": "module",
  "license": "MIT",
  "author": "paopaocat",
  "homepage": "https://github.com/zmm863-commits/dsh-paopaocat-suite",
  "repository": {
    "type": "git",
    "url": "https://github.com/zmm863-commits/dsh-paopaocat-suite.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "welcome",
    "onboarding",
    "新手引导"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6"
  }
}
